{
  "name": "storefront-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.mjs\" \"index.html\" \"vite.config.js\" \"eslint.config.js\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.mjs\" \"index.html\" \"vite.config.js\" \"eslint.config.js\" \"package.json\"",
    "preview": "vite preview"
