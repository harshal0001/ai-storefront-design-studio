# DynamoDB Local
DYNAMODB_ENDPOINT=http://127.0.0.1:8001
DYNAMODB_ACCESS_KEY_ID=local
DYNAMODB_SECRET_ACCESS_KEY=local
AWS_REGION=eu-north-1
DYNAMODB_STYLE_TABLE=StorefrontStyle
DYNAMODB_THEME_PACKAGE_TABLE=ThemePackage
USE_DYNAMODB=true
DEFAULT_SHOP_UUID=demo-merchant

# AgentCore Memory (separate from AWS_REGION — memory resource lives in eu-north-1)
AGENTCORE_MEMORY_REGION=eu-north-1
# Optional: pin a known memory ID. If unset, discovered/created dynamically (SSM not required).
# AGENTCORE_MEMORY_ID=your-memory-id-here

# Bedrock — use real AWS credentials via ~/.aws/credentials or SSO.
# Do not set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY to "local" for design-server.
# AGENT_MODEL=eu.amazon.nova-pro-v1:0
