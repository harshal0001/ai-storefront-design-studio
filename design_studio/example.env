# DynamoDB Local (design_studio) — safe to source for design-server
export DYNAMODB_ENDPOINT=http://127.0.0.1:8001
export DYNAMODB_ACCESS_KEY_ID=local
export DYNAMODB_SECRET_ACCESS_KEY=local
export AWS_REGION=eu-north-1
export DYNAMODB_STYLE_TABLE=StorefrontStyle
export DYNAMODB_THEME_PACKAGE_TABLE=ThemePackage
export USE_DYNAMODB=true
export DEFAULT_SHOP_UUID=demo-merchant

# AgentCore Memory (separate from AWS_REGION — memory resource lives in eu-north-1)
export AGENTCORE_MEMORY_REGION=eu-north-1
export AGENTCORE_MEMORY_STAGE=local
# Optional: pin your environment's memory resource (exact ID or resource name)
# export AGENTCORE_MEMORY_ID=your-memory-id-here
# Optional: override the default ConversationalAgentMemory-{stage} name
# export AGENTCORE_MEMORY_NAME=ConversationalAgentMemory-local

# Bedrock: use your real AWS profile (do NOT set AWS_ACCESS_KEY_ID=local here).
# Before running design-server: aws sso login  OR  aws configure
# Optional override:
# export AGENT_MODEL=eu.amazon.nova-pro-v1:0
