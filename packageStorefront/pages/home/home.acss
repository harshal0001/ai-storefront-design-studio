.home-background {
  width: 100vw;
  height: 476rpx;
}

.store-banner {
  width: 100vw;
  height: 476rpx;
}

.store-logo {
  bottom: 0;
  left: 0;
  width: 100%;
  height: 182rpx;
}

.store-logo__image {
  border-radius: 50%;
  width: 142rpx;
  height: 142rpx;
  background-color: #fff;
}

.store-logo-background {
  bottom: 0;
  left: 0;
  width: 100%;
  height: 106rpx;
}

.home-main {
  padding-top: 2rpx;
  transform: translateY(-2rpx);
  flex-direction: column;
  background-color: #fff;
}

/* Store information */
.store-info-head {
  align-items: center;
  justify-content: space-between;
  min-height: 60rpx;
  height: auto;
  padding: 0 20rpx 0 40rpx;
  font-weight: 600;
  font-size: 36rpx;
  line-height: 60rpx;
  color: #090809;
}

.info-collapsed .store-info-head {
  height: 60rpx;
  word-break: break-word;
}

.info-collapsed .info-collapsed__icon {
  transform: rotate(0.5turn);
}

.info-collapsed__icon {
  flex: none;
  width: 60rpx;
  height: 60rpx;
}

.store-info-content {
  flex-direction: column;
}

.info-collapsed>.store-info-content {
  overflow: hidden;
  height: 0;
}

.store-info-facade {
  flex-direction: column;
  padding: 0 80rpx 40rpx 40rpx;
}

.store-description {
  padding-bottom: 34rpx;
  font-size: 28rpx;
  line-height: 36rpx;
  letter-spacing: 0.4rpx;
  color: #5F6E7D;
}

.store-labels {
  flex-wrap: wrap;
  gap: 34rpx 8rpx;
}

.store-label {
  max-width: 100%;
  border-radius: 40rpx;
  border: 2rpx solid #5F6E7D;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  line-height: 22rpx;
  color: #5F6E7D;
  word-break: break-all;
  overflow-wrap: break-word;
  white-space: normal;
}

.store-label-primary {
  border-color: #B63F81;
  color: #B63F81;
}

.store-label-category {
  border-radius: 10rpx;
  padding: 9rpx 16rpx;
  color: #fff;
  font-weight: 500;
  font-size: 24rpx;
  line-height: 28rpx;
  word-break: break-all;
  overflow-wrap: break-word;
  white-space: normal;
  background-color: #070607;
}

.store-features {
  padding-top: 34rpx;
  column-gap: 8rpx;
}

.store-feature {
  width: 96rpx;
  height: 96rpx;
}

.store-address {
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 30rpx;
  column-gap: 30rpx;
}

.store-address__icon {
  flex: none;
}

.store-address__text {
  flex: 1;
}

.store-closed {
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 30rpx;
  column-gap: 30rpx;
}

.store-closed__icon {
  flex: none;
}

.store-closed-description {
  flex: 1;
  font-size: 26rpx;
  line-height: 32rpx;
  letter-spacing: -0.4rpx;
  color: #070607;
}

.closed-collapsed .closed-collapsed__icon {
  transform: rotate(0.5turn);
}

.store-closed-content {
  padding: 30rpx 110rpx 0;
  flex-direction: column;
  row-gap: 20rpx;
}

.closed-collapsed .store-closed-content {
  overflow: hidden;
  height: 0;
}

.store-closed-label {
  font-weight: 500;
  font-size: 18rpx;
  line-height: 20rpx;
  text-transform: uppercase;
  color: #999;
}

.store-closed-item {
  column-gap: 30rpx;
  justify-content: space-between;
  font-weight: 500;
  font-size: 26rpx;
  line-height: 32rpx;
  letter-spacing: -0.4rpx;
}

.store-closed-week {
  color: #121217;
}

.store-closed-time {
  flex-direction: column;
  row-gap: 10rpx;
  color: #5F6E7D;
}


.store-follow {
  background-color: #fff;
  padding: 40rpx 46rpx 0;
}

.store-follow__btn {
  margin-bottom: 40rpx;
  border-radius: 100rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-weight: 500;
  font-size: 26rpx;
  letter-spacing: 2.88rpx;
  text-transform: uppercase;
}

.store-follow__btn,
.store-follow__btn:active,
.store-follow__btn:hover {
  background-color: #B63F81;
  border-color: #B63F81;
  outline-color: #B63F81;
}

/* Store marketing */
.store-market {
  border-radius: 40rpx 40rpx 0 0;
  /* safe area */
  padding-bottom: 120rpx;
  flex-direction: column;
  background-color: #F4F6F9;
}

.store-ad-module {
  padding-top: 40rpx;
}

.store-ad {
  align-items: center;
  justify-self: center;
  column-gap: 20rpx;
  margin: 0 auto 34rpx;
  border-radius: 20rpx;
  width: 680rpx;
  height: 110rpx;
  padding: 0 20rpx;
  background-color: #fff;
}

.store-ad-logo {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  background-color: #fff;
}

.store-ad-context {
  height: 72rpx;
  font-size: 28rpx;
  line-height: 36rpx;
  letter-spacing: -0.4rpx;
  color: rgba(0, 0, 0, .55);
}

.store-ad-action {
  flex: none;
  height: 82rpx;
  align-items: flex-end;
}

.store-ad-action__image {
  width: 28rpx;
  height: 28rpx;
}

/* Marketing item */
.store-market-item {
  padding: 34rpx 20rpx;
}

.store-market-item-swiper {
  margin-bottom: 34rpx;
}

.store-products {
  grid-template-columns: 1fr 1fr;
  column-gap: 22rpx;
}
