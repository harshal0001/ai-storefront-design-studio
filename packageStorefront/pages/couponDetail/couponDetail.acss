:global(.coupon-detail-wrapper) {
  min-height: 100vh;
  background-color: #F4F6F9;
}

.coupon-detail {
  width: 100%;
  background-color: #fff;
}

.coupon-detail::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  border-radius: 0 0 20rpx 20rpx;
  width: 100%;
  height: 158rpx;
  background-color: #B63F81;
}

.coupon-wrapper {
  width: 100%;
  padding: 10rpx 24rpx 30rpx;
}

.coupon-barcode-number {
  padding: 40rpx 0 22rpx;
  font-weight: 500;
  font-size: 22rpx;
  line-height: 32rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.coupon-barcode__image {
  width: 610rpx;
  height: 118rpx;
}

.coupon-barcode-tip {
  padding: 40rpx 0 16rpx;
  font-size: 24rpx;
  line-height: 28rpx;
  color: #B63F81;
}
